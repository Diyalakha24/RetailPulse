<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RetailPulse</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="rp-header">
        <div class="container rp-header-inner">
            <div class="rp-brand">
                <span class="rp-brand-mark">RP</span>
                <div>
                    <div class="rp-brand-name">RetailPulse</div>
                    <div class="rp-brand-tagline">Retail Sales Analytics</div>
                </div>
            </div>
            <nav class="rp-nav">
                <a class="rp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="rp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Import" ? "active" : "")"
                   asp-controller="Import" asp-action="Index">Import Data</a>
            </nav>
        </div>
    </header>

    <main class="container rp-main">
        @RenderBody()
    </main>

    <footer class="rp-footer">
        <div class="container">
            RetailPulse &mdash; a portfolio project demonstrating ASP.NET Core MVC, EF Core, SQLite and data analytics.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
